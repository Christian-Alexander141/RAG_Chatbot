<mxfile host="drawio">
  <diagram id="ablauf" name="Ablauf einer Anfrage">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="720" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Eingang -->
        <mxCell id="msg" value="Nachricht im Chat" style="rounded=1;arcSize=50;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="20" width="200" height="46" as="geometry" />
        </mxCell>

        <!-- Entscheidung 1: Bild- oder Videowunsch -->
        <mxCell id="d1" value="Bild- oder&#xa;Videowunsch?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="95" y="105" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="imgagent" value="Bild- bzw. Video-Agent&#xa;schreibt englischen Prompt&#xa;(Sprachmodell über Ollama)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flux" value="FLUX.2 [klein] 4B: Bild&#xa;Kandinsky 6.0 Video Lite:&#xa;Video mit Ton (GPU)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out1" value="Bild oder Video&#xa;im Chat" style="rounded=1;arcSize=50;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="127" width="170" height="46" as="geometry" />
        </mxCell>

        <!-- Entscheidung 2: Dokumentanfrage -->
        <mxCell id="d2" value="Dokument-&#xa;anfrage?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="95" y="235" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lookup" value="Dokumentsuche&#xa;Dateinamen abgleichen&#xa;(ohne Sprachmodell)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="250" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out2" value="Link zum Dokument" style="rounded=1;arcSize=50;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="257" width="170" height="46" as="geometry" />
        </mxCell>

        <!-- Hybride Suche -->
        <mxCell id="hybrid" value="Hybride Suche" style="swimlane;startSize=26;rounded=1;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;swimlaneFillColor=#f4f8fd;" vertex="1" parent="1">
          <mxGeometry x="30" y="370" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="dense" value="Embedding-Suche&#xa;(Bedeutung, Qdrant)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="hybrid">
          <mxGeometry x="12" y="42" width="124" height="54" as="geometry" />
        </mxCell>
        <mxCell id="bm25" value="BM25&#xa;(exakte Begriffe)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="hybrid">
          <mxGeometry x="144" y="42" width="124" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rrf" value="Reciprocal Rank Fusion&#xa;beste Textabschnitte" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="hybrid">
          <mxGeometry x="55" y="128" width="170" height="54" as="geometry" />
        </mxCell>

        <!-- Werkzeug-Agent und Chat-Modell -->
        <mxCell id="agent" value="Werkzeug-Agent&#xa;Tools: Dokumente, Dateien, Bild,&#xa;Video, eigene neuronale Netze" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="498" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="chatmodel" value="Chat-Modell&#xa;formuliert die Antwort" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="498" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out3" value="Antwort im Chat&#xa;(Wort für Wort)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="503" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Hauptlinie -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="msg" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#9673a6;fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="imgagent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="imgagent" target="flux">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="flux" target="out1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#82b366;fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="lookup" target="out2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#666666;fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="hybrid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="hybrid" source="dense" target="rrf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="hybrid" source="bm25" target="rrf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Dokument-&#xa;auszüge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rrf" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" parent="1" source="agent" target="chatmodel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" parent="1" source="chatmodel" target="out3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Rückfall: Werkzeug-Agent erkennt einen Bild- oder Videowunsch selbst -->
        <mxCell id="e14" value="generate_image / generate_video&#xa;(Wunsch nicht erkannt)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.05;exitY=0;entryX=0.05;entryY=1;" edge="1" parent="1" source="agent" target="imgagent">
          <mxGeometry x="-0.45" relative="1" as="geometry">
            <mxPoint x="62" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Hinweis Modelle -->
        <mxCell id="note" value="Alle Modelle laufen lokal (Ollama, FLUX, Kandinsky, eigene Netze aus networks/).&#xa;Sprach-, Bild- und Videomodelle wählt jeder Nutzer in den Einstellungen, das Embedding-Modell gilt für alle." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#999999;fontColor=#555555;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="600" width="690" height="40" as="geometry" />
        </mxCell>

        <!-- Legende -->
        <mxCell id="l1" value="Bild und Video" style="rounded=1;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="600" width="140" height="18" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="ohne Sprachmodell" style="rounded=1;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="600" width="140" height="18" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="Suche in der Wissensbasis" style="rounded=1;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="624" width="140" height="18" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="Sprachmodelle" style="rounded=1;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="624" width="140" height="18" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
